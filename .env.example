# Copia questo file in .env e inserire i propri valori

# Bot Telegram
TELEGRAM_BOT_TOKEN=Inserire token del bot

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=Percorso/per/le/credenziali.json
SPREADSHEET_URL=Url dello spreadsheet come compare nel browser
WORKSHEET_NAME=Worksheet

# Gruppo
GRUPPO_CACCA=il tuo gruppo

# Logging
#LOG_LEVEL=INFO

# Ogni quanto (in minuti) il bot guarda se ci sono cacche da inserire
#FREQUENZA_CHECK=60

# Tempo in minuti prima che le cacche vengano inserite definitivamente nello spreadsheet
#TEMPO_PER_RMCACCA=1440
